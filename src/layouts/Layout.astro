---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  bare?: boolean;
}

const { title, description, bare = false } = Astro.props;
const siteOrigin = Astro.site ?? new URL('https://openpreflight.xyz');
const canonical = new URL(Astro.url.pathname, siteOrigin);
const ogImage = new URL('/og.png', siteOrigin);
const llmsTxt = new URL('/llms.txt', siteOrigin);
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const markdownAlternate = new URL('/index.md', siteOrigin);
const DOCS = 'https://docs.openpreflight.xyz';
const REPO = 'https://github.com/openpreflight/openpreflight';
const ogAlt =
  'openpreflight wordmark, the tagline "A small CI provider for private repos", and a passing Check Run panel.';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#2f6f4f" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="describedby" href={llmsTxt} />
    {isHome ? (
      <link rel="alternate" type="text/markdown" href={markdownAlternate} title="Markdown" />
    ) : null}

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="openpreflight" />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="openpreflight" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
  </head>
  <body class="font-sans antialiased">
    {
      bare ? (
        <slot />
      ) : (
        <>
          <a class="skip-link" href="#content">
            Skip to content
          </a>
          <main id="content">
            <slot />
          </main>
          <footer class="border-t border-border">
            <div class="mx-auto max-w-3xl px-6 py-10 text-sm text-muted-foreground">
              <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-2">
                <a href={DOCS} class="hover:text-foreground">Documentation</a>
                <a href={REPO} class="hover:text-foreground">GitHub</a>
                <a href={`${REPO}/releases`} class="hover:text-foreground">Releases</a>
                <a href={`${REPO}/blob/main/SECURITY.md`} class="hover:text-foreground">
                  Security
                </a>
                <a href={`${REPO}/blob/main/LICENSE`} class="hover:text-foreground">
                  Apache-2.0
                </a>
              </nav>
              <p class="mt-6">Self-hosted. It runs on a server you control.</p>
            </div>
          </footer>
        </>
      )
    }
  </body>
</html>
