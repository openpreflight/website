---
import Layout from './Layout.astro';
import SiteHeader from '../components/marketing/SiteHeader.astro';
import { Footer01 } from '../components/blocks/footer-01';
import { footerGroups } from '../lib/site';

interface Props {
  title: string;
  description: string;
  index?: boolean;
}

const { title, description, index = true } = Astro.props;

let githubStars: number | null = null;
try {
  const res = await fetch(
    'https://api.github.com/repos/openpreflight/openpreflight',
    {
      headers: {
        Accept: 'application/vnd.github+json',
        'User-Agent': 'openpreflight-website',
      },
    },
  );
  if (res.ok) {
    const data = (await res.json()) as { stargazers_count?: number };
    if (typeof data.stargazers_count === 'number') {
      githubStars = data.stargazers_count;
    }
  }
} catch {
  githubStars = null;
}
---

<Layout title={title} description={description} bare index={index}>
  <div class="min-h-screen bg-background text-foreground">
    <a class="skip-link" href="#content">Skip to content</a>
    <SiteHeader />
    <main id="content"><slot /></main>
    <Footer01
      brand="openpreflight"
      description="Self-hosted. The runner and the logs stay on your server."
      groups={footerGroups}
      showNewsletter={false}
      githubStars={githubStars}
    />
  </div>
</Layout>
