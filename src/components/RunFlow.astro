---
interface Step {
  title: string;
  detail: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<ol class="mt-7 space-y-0">
  {
    steps.map((step, i) => (
      <li class="relative flex gap-4 pb-8 last:pb-0">
        {i < steps.length - 1 && (
          <span
            class="absolute left-[15px] top-8 bottom-0 w-px bg-[var(--edge)]"
            aria-hidden="true"
          />
        )}
        <span
          class="relative z-10 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[var(--edge)] bg-[var(--raised)] font-mono text-xs text-[var(--accent)]"
        >
          {i + 1}
        </span>
        <div class="pt-1">
          <p class="font-medium">{step.title}</p>
          <p class="mt-1 text-sm leading-relaxed text-[var(--ink-muted)]">{step.detail}</p>
        </div>
      </li>
    ))
  }
</ol>
