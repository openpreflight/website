---
interface Props {
  lines: string[];
}

const { lines } = Astro.props;
---

<figure
  class="overflow-hidden rounded-lg border border-[var(--edge)] bg-[var(--raised)] shadow-[0_1px_0_rgba(0,0,0,0.04)]"
>
  <figcaption
    class="flex items-center gap-2 border-b border-[var(--edge)] px-4 py-2.5 font-mono text-xs text-[var(--ink-muted)]"
  >
    <span class="inline-block h-2 w-2 rounded-full bg-[var(--pass)]" aria-hidden="true"></span>
    Check run
  </figcaption>
  <pre class="overflow-x-auto p-5 font-mono text-sm leading-relaxed"><code
    >{
      lines.map((line) => {
        const isPass = line.trimStart().startsWith('✓');
        const isSep = line.includes('──');
        const isTitle = line.trim() === 'openpreflight';
        let cls = 'block text-[var(--ink)]';
        if (isPass) cls = 'block text-[var(--pass)]';
        else if (isSep || isTitle) cls = 'block text-[var(--ink-muted)]';
        if (isSep) {
          return (
            <span class={cls} aria-hidden="true">
              {line || '\u00a0'}
            </span>
          );
        }
        return <span class={cls}>{line || '\u00a0'}</span>;
      })
    }</code
  ></pre>
</figure>
