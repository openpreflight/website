---
/** Closing cross-link band. Every page ends with somewhere useful to go. */
interface Link {
  label: string;
  href: string;
  description: string;
}

interface Props {
  title?: string;
  links: Link[];
}

const { title = 'Keep reading', links } = Astro.props;
---

<section class="px-5 pb-20 sm:px-8 sm:pb-24">
  <div class="mx-auto max-w-6xl rounded-[2rem] border border-foreground/10 px-6 py-10 sm:px-10 sm:py-12">
    <h2 class="font-mono text-xs font-semibold uppercase tracking-[0.06em] text-muted-foreground">
      {title}
    </h2>
    <ul class="mt-7 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        links.map((link) => (
          <li>
            <a class="group block" href={link.href}>
              <span class="inline-flex items-center gap-1.5 text-base font-semibold tracking-[-.02em] group-hover:text-primary">
                {link.label}
                <span aria-hidden="true" class="text-primary transition-transform group-hover:translate-x-0.5">
                  →
                </span>
              </span>
              <span class="mt-1.5 block text-sm leading-relaxed text-muted-foreground">
                {link.description}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
