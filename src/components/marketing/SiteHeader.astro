---
import { CTA, DOCS, REPO } from '../../lib/site';

const links = [
  { label: 'Product', href: '/product/' },
  { label: 'Compare', href: '/compare/github-actions/' },
  { label: 'Security', href: '/security/' },
  { label: 'Docs', href: DOCS },
];
---

<header class="sticky top-0 z-50 border-b border-foreground/8 bg-background/86 backdrop-blur-xl">
  <div class="relative mx-auto flex h-16 w-full max-w-7xl items-center gap-6 px-5 sm:px-8">
    <a class="flex shrink-0 items-center gap-2.5 font-semibold tracking-tight" href="/">
      <img alt="" class="size-9" height="36" src="/favicon.svg" width="36" />
      <span>openpreflight</span>
    </a>

    <nav aria-label="Main" class="ml-auto hidden items-center gap-1 md:flex">
      {links.map((link) => (
        <a
          class="rounded-lg px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-foreground/[.045] hover:text-foreground"
          href={link.href}
        >
          {link.label}
        </a>
      ))}
      <a
        aria-label="GitHub repository"
        class="ml-1 grid size-9 place-items-center rounded-xl text-muted-foreground transition-colors hover:bg-foreground/[.055] hover:text-foreground"
        href={REPO}
      >
        <svg aria-hidden="true" class="size-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.39.6.11.82-.26.82-.58 0-.28-.01-1.04-.02-2.04-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.81 1.1.81 2.22 0 1.6-.01 2.89-.01 3.29 0 .32.22.7.82.58C20.56 21.8 24 16.3 24 12 24 5.37 18.63 0 12 0z" />
        </svg>
      </a>
      <a
        class="ml-2 inline-flex h-10 items-center justify-center rounded-[0.8rem_0.8rem_0.8rem_0.3rem] bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-[0_10px_28px_-16px_var(--primary)] transition-transform hover:-translate-y-0.5"
        href={CTA.quickstart}
      >
        Install
      </a>
    </nav>

    <details class="group ml-auto md:hidden">
      <summary
        class="grid size-10 cursor-pointer list-none place-items-center rounded-xl border border-foreground/12 bg-background text-foreground [&::-webkit-details-marker]:hidden"
        aria-label="Open navigation"
      >
        <svg aria-hidden="true" class="size-5 group-open:hidden" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewBox="0 0 24 24">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg aria-hidden="true" class="hidden size-5 group-open:block" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewBox="0 0 24 24">
          <path d="m6 6 12 12M18 6 6 18" />
        </svg>
      </summary>
      <nav
        aria-label="Mobile"
        class="absolute inset-x-5 top-[calc(100%+.5rem)] rounded-2xl border border-foreground/12 bg-background p-2 shadow-[0_24px_70px_-30px_var(--foreground)] sm:inset-x-8"
      >
        {links.map((link) => (
          <a class="block rounded-xl px-4 py-3 text-sm font-medium hover:bg-primary/10" href={link.href}>
            {link.label}
          </a>
        ))}
        <a class="block rounded-xl px-4 py-3 text-sm font-medium hover:bg-primary/10" href={REPO}>
          GitHub
        </a>
        <a class="mt-2 block rounded-xl bg-primary px-4 py-3 text-center text-sm font-semibold text-primary-foreground" href={CTA.quickstart}>
          Install openpreflight
        </a>
      </nav>
    </details>
  </div>
</header>
