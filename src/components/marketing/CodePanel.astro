---
/** Dark code panel with a filename bar, same chrome as the hero panel. */
interface Props {
  label?: string;
  code: string;
  class?: string;
}

const { label, code, class: className = '' } = Astro.props;
---

<figure
  class={`overflow-hidden rounded-[1.25rem] border border-[#2a2f2a] bg-[#121412] text-[#e8ebe6] ${className}`.trim()}
>
  {
    label && (
      <figcaption class="flex h-10 items-center gap-2.5 border-b border-white/10 bg-white/[0.03] px-4">
        <span aria-hidden="true" class="size-2 shrink-0 rounded-full bg-[#7cc79c]" />
        <span class="truncate font-mono text-xs text-white/50">{label}</span>
      </figcaption>
    )
  }
  <pre
    class="overflow-x-auto p-5 font-mono text-[0.8rem] leading-relaxed sm:text-sm"><code>{code}</code></pre>
</figure>
