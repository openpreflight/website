---
import Layout from '../layouts/Layout.astro';

const DOCS = 'https://docs.openpreflight.xyz';
---

<Layout
  title="Page not found — openpreflight"
  description="That page does not exist on openpreflight.xyz."
>
  <div class="mx-auto max-w-3xl px-6 py-24">
    <p class="font-mono text-sm text-[var(--accent)]">404</p>
    <h1 class="mt-4 text-3xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-4 leading-relaxed text-[var(--ink-muted)]">
      That URL is not on this site. Head home, open the docs, or jump straight to the
      quickstart.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/"
        class="rounded-md bg-[var(--accent)] px-4 py-2 text-sm font-medium text-[var(--on-accent)] transition hover:bg-[var(--accent-hover)]"
      >
        Home
      </a>
      <a
        href={DOCS}
        class="rounded-md border border-[var(--edge-strong)] px-4 py-2 text-sm font-medium transition hover:bg-[var(--raised)]"
      >
        Documentation
      </a>
      <a
        href={`${DOCS}/start/quickstart/`}
        class="rounded-md border border-[var(--edge-strong)] px-4 py-2 text-sm font-medium transition hover:bg-[var(--raised)]"
      >
        Quickstart
      </a>
      <a
        href="https://github.com/openpreflight/openpreflight"
        class="rounded-md border border-[var(--edge-strong)] px-4 py-2 text-sm font-medium transition hover:bg-[var(--raised)]"
      >
        GitHub
      </a>
    </div>
  </div>
</Layout>
