---
import MarketingPage from '../layouts/MarketingPage.astro';
import { CTA, DOCS, REPO } from '../lib/site';
---

<MarketingPage title="Not found · openpreflight" description="That URL is not on this site.">
  <p class="kicker">404</p>
  <h1>Page not found</h1>
  <p class="lead">That URL is not on this site. The links below cover everything that is.</p>
  <div class="cta-row">
    <a class="primary" href="/">Home</a>
    <a class="secondary" href="/product/">Product</a>
    <a class="secondary" href={DOCS}>Docs</a>
    <a class="secondary" href={CTA.quickstart}>Quickstart</a>
    <a class="secondary" href={REPO}>GitHub</a>
  </div>
</MarketingPage>
