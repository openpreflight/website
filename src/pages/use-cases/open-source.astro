---
import MarketingPage from '../../layouts/MarketingPage.astro';
import PageHero from '../../components/marketing/PageHero.astro';
import Section from '../../components/marketing/Section.astro';
import Grid from '../../components/marketing/Grid.astro';
import Card from '../../components/marketing/Card.astro';
import Actions from '../../components/marketing/Actions.astro';
import CtaLink from '../../components/marketing/CtaLink.astro';
import Callout from '../../components/marketing/Callout.astro';
import Prose from '../../components/marketing/Prose.astro';
import CheckRunPanel from '../../components/marketing/CheckRunPanel.astro';
import { CTA, REPO } from '../../lib/site';

const panelSteps = [
  { name: 'install', command: 'npm ci', duration: '7s', width: '24%' },
  { name: 'test', command: 'npm test', duration: '11s', width: '38%', state: 'fail' as const },
  { name: 'build', command: 'npm run build', duration: '-', width: '0%', state: 'skip' as const },
];
---

<MarketingPage
  title="Open-source contributors · openpreflight"
  description="The same worker checks a public GitHub repo if you bind one. Visibility never gates a run."
>
  <PageHero
    kicker="Open source"
    title="Public repos work the same"
    lead="Repository visibility is read from the webhook payload and never gates anything. Bind a public repo, opt that binding into shareable logs if you want, and contributors see the same Check Run an operator would."
    crumbs={[
      { label: 'openpreflight', href: '/' },
      { label: 'Use cases', href: '/use-cases/' },
      { label: 'Open source' },
    ]}
  >
    <Actions slot="actions">
      <CtaLink href={CTA.quickstart} variant="primary" size="lg">Quickstart</CtaLink>
      <CtaLink href="/open-source/" variant="outline" size="lg">Contributing</CtaLink>
    </Actions>
    <CheckRunPanel
      slot="visual"
      label="Check Run · public pull request"
      repo="your-org/library"
      meta={['#3', 'failing-test']}
      conclusion="failed"
      duration="18s"
      steps={panelSteps}
      footer="View full logs"
    />
  </PageHero>

  <Section badge="What you get" title="Same worker, public or private" tone="dark">
    <Grid class="mt-12" cols={3}>
      <Card title="No second product" tone="dark">
        There is no hosted openpreflight for arbitrary public repos. An instance
        you run can check a public repo you bound.
      </Card>
      <Card title="Shareable logs are opt-in" tone="dark">
        Per binding. Everywhere else the log page still needs a session on your
        instance.
      </Card>
      <Card title="Contribute on the product" tone="dark">
        Issues and pull requests belong on the Go repository, not on a fixture
        you stood up to try it.
      </Card>
    </Grid>
  </Section>

  <Section badge="Then what" title="If you want to poke at the code">
    <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:items-center">
      <Prose>
        <p>
          The test suite runs offline. The most useful contributions are a bug
          report with a failing test, a gap already in scope the code does not cover yet,
          and docs corrected to match the code.
        </p>
      </Prose>
      <div class="rounded-[1.5rem] border border-foreground/10 p-6 sm:p-7">
        <h3 class="text-lg font-semibold tracking-[-.03em]">Useful contributions</h3>
        <ul class="mt-5 space-y-3">
          {
            [
              'A bug report with a failing test',
              'A gap already in scope the code does not cover yet',
              'Docs corrected to match the code',
            ].map((item) => (
              <li class="flex items-start gap-2.5 text-sm leading-relaxed text-muted-foreground">
                <span aria-hidden="true" class="mt-0.5 font-mono text-primary">✓</span>
                {item}
              </li>
            ))
          }
        </ul>
        <a
          class="mt-6 inline-block font-mono text-xs text-primary underline underline-offset-4"
          href={`${REPO}/blob/main/CONTRIBUTING.md`}
        >
          CONTRIBUTING.md →
        </a>
      </div>
    </div>
    <Callout class="mt-8" title="This is not a hosted CI">
      <p>
        Every instance is one someone runs, bound to repos they chose. The
        <a href={CTA.quickstart}>quickstart</a> is how you get one.
      </p>
    </Callout>
    <Actions>
      <CtaLink href="/open-source/" variant="outline">Open source</CtaLink>
      <CtaLink href="/product/" variant="outline">How it works</CtaLink>
    </Actions>
  </Section>
</MarketingPage>
