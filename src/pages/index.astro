---
import Layout from '../layouts/Layout.astro';
import { SaasLanding01 } from '../components/templates/saas-landing-01';

const REPO = 'https://github.com/openpreflight/openpreflight';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['SoftwareApplication', 'SoftwareSourceCode'],
  name: 'openpreflight',
  description:
    'Self-hosted CI without the CI platform: every commit gets a native GitHub Check Run, written by a GitHub App you own, from one Go binary and one SQLite file on a server you already run.',
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  codeRepository: REPO,
  programmingLanguage: 'Go',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux',
  url: 'https://openpreflight.xyz',
};
---

<Layout
  title="openpreflight · self-hosted CI without the CI platform"
  description="Self-hosted CI without the CI platform: every commit gets a native GitHub Check Run, written by a GitHub App you own, from one Go binary and one SQLite file on a server you already run."
  bare
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <SaasLanding01 client:load />
</Layout>
