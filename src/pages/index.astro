---
import Layout from '../layouts/Layout.astro';
import { SaasLanding01 } from '../components/templates/saas-landing-01';
import { ORG_ID, SOFTWARE_ID } from '../lib/seo';
import { REPO, SITE, tagline } from '../lib/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['SoftwareApplication', 'SoftwareSourceCode'],
  '@id': SOFTWARE_ID,
  name: 'openpreflight',
  description: tagline,
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  codeRepository: REPO,
  programmingLanguage: 'Go',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux',
  url: SITE,
  image: `${SITE}/og.png`,
  publisher: { '@id': ORG_ID },
};
---

<Layout
  title="openpreflight · self-hosted CI without the CI platform"
  description="Self-hosted CI without the CI platform. Native GitHub Check Runs from one Go binary and one SQLite file on a server you run."
  bare
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <SaasLanding01 client:load />
</Layout>
