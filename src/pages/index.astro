---
import Layout from '../layouts/Layout.astro';
import CheckRunPanel from '../components/CheckRunPanel.astro';
import RunFlow from '../components/RunFlow.astro';
import { Code } from 'astro:components';

const DOCS = 'https://docs.openpreflight.xyz';
const REPO = 'https://github.com/openpreflight/openpreflight';

const checkRunLines = [
  'openpreflight',
  '────────────────────',
  '✓ install    8s',
  '✓ test      21s',
  '✓ build     13s',
  '',
  'Passed in 42s',
  '',
  'View full logs →',
];

const runSteps = [
  {
    title: 'Webhook validates and enqueues',
    detail:
      'GitHub POSTs /webhook/{slug}. HMAC is verified with that App\'s secret; an enabled binding and allowed branch are required. Duplicate deliveries drop; stale SHAs cancel. Returns 202 within ten seconds.',
  },
  {
    title: 'Worker mints a token and opens a Check Run',
    detail:
      'An installation token is minted from the payload. The Check Run is created, then the exact commit is fetched, detached, and the remote is stripped before any pipeline step runs.',
  },
  {
    title: 'Pipeline runs under a timeout',
    detail:
      'Steps run in-process or via docker run when runtime: is set. The Check Run is completed with a truncated log tail; the full log stays on the details page.',
  },
];

const pipeline = `runtime: node:24
install: npm ci
test: npm test
build: npm run build
timeout: 15m`;

const quickstart = `export CI_SECRET_KEY="$(openssl rand -base64 48)"
export CI_PUBLIC_BASE_URL="https://ci.example.com"
docker compose up --build`;

const notInV1 = [
  'GitHub Actions YAML',
  'actions/runner',
  'Creating GitHub Apps for you',
  'Matrices',
  'Caches',
  'Artifacts',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['SoftwareApplication', 'SoftwareSourceCode'],
  name: 'openpreflight',
  description:
    'A small CI provider for private repos. One Go binary, one SQLite file: register a GitHub App, enable your repos, and get one Check Run per commit with full logs.',
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  codeRepository: REPO,
  programmingLanguage: 'Go',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux',
  url: 'https://openpreflight.xyz',
};
---

<Layout
  title="openpreflight — self-hosted GitHub Check Runs CI"
  description="A small CI provider for private repos. One Go binary, one SQLite file: register a GitHub App, enable your repos, and get one Check Run per commit with full logs."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="mx-auto max-w-3xl px-6">
    <section class="pt-16 pb-14 sm:pt-24">
      <p class="font-mono text-sm text-[var(--accent)]">openpreflight</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">
        A small CI provider for private repos.
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-[var(--ink-muted)]">
        One Go binary that is both a <strong class="font-medium text-[var(--ink)]">configurator</strong>
        — add GitHub Apps and repo bindings in a web UI — and a
        <strong class="font-medium text-[var(--ink)]">worker</strong> that receives webhooks,
        runs install/test/build on the exact commit, and reports one Check Run with full logs.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={`${DOCS}/start/quickstart/`}
          class="rounded-md bg-[var(--accent)] px-4 py-2 text-sm font-medium text-[var(--on-accent)] transition hover:bg-[var(--accent-hover)]"
        >
          Quickstart
        </a>
        <a
          href={REPO}
          class="rounded-md border border-[var(--edge-strong)] px-4 py-2 text-sm font-medium transition hover:bg-[var(--raised)]"
        >
          View source
        </a>
      </div>

      <div class="mt-12">
        <CheckRunPanel lines={checkRunLines} />
        <p class="mt-3 text-sm text-[var(--ink-muted)]">
          That is the whole output surface: one check, per commit, in the pull request.
        </p>
      </div>
    </section>

    <section class="border-t border-[var(--edge)] py-14">
      <h2 class="text-2xl font-semibold tracking-tight">The smallest useful version of GitHub-native CI</h2>
      <p class="mt-5 leading-relaxed text-[var(--ink-muted)]">
        The systems that already fill this slot are full platforms, hosted control planes,
        Kubernetes-oriented, or heavyweight gating systems. This one is a binary and a SQLite
        file on a box you already pay for — for teams that want CI on their own server,
        without Actions and without learning a pipeline DSL.
      </p>

      <dl class="mt-8 grid gap-6 sm:grid-cols-3">
        <div>
          <dt class="font-medium">One process</dt>
          <dd class="mt-1 text-sm leading-relaxed text-[var(--ink-muted)]">
            UI, JSON API, webhook receiver, and job runner. No broker, no separate frontend.
          </dd>
        </div>
        <div>
          <dt class="font-medium">One file of state</dt>
          <dd class="mt-1 text-sm leading-relaxed text-[var(--ink-muted)]">
            SQLite, with every secret column AES-256-GCM encrypted at rest.
          </dd>
        </div>
        <div>
          <dt class="font-medium">Configured in a UI</dt>
          <dd class="mt-1 text-sm leading-relaxed text-[var(--ink-muted)]">
            Apps, tokens, and repo bindings live in the database — not in a pile of env vars.
          </dd>
        </div>
      </dl>
    </section>

    <section class="border-t border-[var(--edge)] py-14">
      <h2 class="text-2xl font-semibold tracking-tight">How a run happens</h2>
      <p class="mt-5 leading-relaxed text-[var(--ink-muted)]">
        The webhook has ten seconds to answer, so it validates and enqueues; the worker does
        the slow part. The commit is fetched by SHA and detached, and the remote is stripped
        before any pipeline step runs.
      </p>
      <RunFlow steps={runSteps} />
    </section>

    <section class="border-t border-[var(--edge)] py-14">
      <h2 class="text-2xl font-semibold tracking-tight">Gated on the commit, not on the push</h2>
      <p class="mt-5 leading-relaxed text-[var(--ink-muted)]">
        Runs trigger on the check suite, build the immutable SHA, and hold to one live run per
        commit — the way Zuul does it. That is a deliberate borrowing of the model, and an
        explicit rejection of its implementation: no ZooKeeper, no Nodepool, no Ansible, no
        second scheduler.
      </p>
      <p class="mt-5 leading-relaxed text-[var(--ink-muted)]">
        The decision record says what it takes, what it refuses, and where the ceiling is.
      </p>
      <a
        href={`${DOCS}/adr/005-check-suite-gating/`}
        class="mt-6 inline-block font-mono text-sm text-[var(--accent)] hover:underline"
      >
        Read ADR 005 →
      </a>
    </section>

    <section class="border-t border-[var(--edge)] py-14">
      <h2 class="text-2xl font-semibold tracking-tight">A pipeline file, or nothing at all</h2>
      <p class="mt-5 leading-relaxed text-[var(--ink-muted)]">
        Commit a <code class="font-mono text-sm">.ci.yml</code>. Set
        <code class="font-mono text-sm">runtime</code> to run steps in a container, or omit it
        to run them in the worker process.
      </p>
      <div
        class="mt-7 overflow-x-auto rounded-lg border border-[var(--edge)] bg-[var(--raised)] p-5 font-mono text-sm leading-relaxed [&_pre]:m-0 [&_pre]:bg-transparent [&_pre]:p-0"
      >
        <Code code={pipeline} lang="yaml" themes={{ light: 'github-light', dark: 'github-dark' }} />
      </div>
      <p class="mt-5 leading-relaxed text-[var(--ink-muted)]">
        With no file, commands fall back to the repo binding's overrides, then to Node defaults
        inferred from <code class="font-mono text-sm">package.json</code> — and if there is
        genuinely nothing to run, the check reports <strong class="font-medium text-[var(--ink)]">skipped</strong>
        rather than failed.
      </p>
      <a
        href={`${DOCS}/using/pipelines/`}
        class="mt-6 inline-block font-mono text-sm text-[var(--accent)] hover:underline"
      >
        Pipeline reference →
      </a>
    </section>

    <section class="border-t border-[var(--edge)] py-14">
      <h2 class="text-2xl font-semibold tracking-tight">Where Coolify fits</h2>
      <p class="mt-5 leading-relaxed text-[var(--ink-muted)]">
        Coolify is a supported deployment target and an optional repo source —
        <strong class="font-medium text-[var(--ink)]">not the product, and not required</strong>.
        Add a team-scoped API token and you get server inventory, a repository picker, and a
        one-click install of this worker. Skip it entirely and everything else works the same.
      </p>
      <p class="mt-5 leading-relaxed text-[var(--ink-muted)]">
        The checks always come from a GitHub App you register — only an App can create Check
        Runs, and an App has exactly one webhook URL, which is why Coolify's own GitHub
        connector cannot do this job.
      </p>
    </section>

    <section class="border-t border-[var(--edge)] py-14">
      <h2 class="text-2xl font-semibold tracking-tight">Run it</h2>
      <div
        class="mt-7 overflow-x-auto rounded-lg border border-[var(--edge)] bg-[var(--raised)] p-5 font-mono text-sm leading-relaxed [&_pre]:m-0 [&_pre]:bg-transparent [&_pre]:p-0"
      >
        <Code code={quickstart} lang="bash" themes={{ light: 'github-light', dark: 'github-dark' }} />
      </div>
      <p class="mt-5 leading-relaxed text-[var(--ink-muted)]">
        Then open the UI, complete the first-boot wizard, register your GitHub App, and check
        the repos you want checks for. You will also need a public HTTPS URL GitHub can reach.
      </p>
      <a
        href={`${DOCS}/start/quickstart/`}
        class="mt-6 inline-block font-mono text-sm text-[var(--accent)] hover:underline"
      >
        Full quickstart →
      </a>
    </section>

    <section class="border-t border-[var(--edge)] py-14">
      <h2 class="text-2xl font-semibold tracking-tight">What it isn't</h2>
      <p class="mt-5 leading-relaxed text-[var(--ink-muted)]">
        Published so you can rule it out in a minute rather than an afternoon. None of this is
        in v1:
      </p>
      <ul class="mt-6 grid gap-2 sm:grid-cols-2">
        {
          notInV1.map((item) => (
            <li class="flex gap-2 text-sm text-[var(--ink-muted)]">
              <span class="font-mono text-[var(--ink-muted)]">✕</span>
              {item}
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-sm leading-relaxed text-[var(--ink-muted)]">
        Jobs on another machine use a Docker engine via
        <code class="font-mono">CI_DOCKER_HOST</code>, not Coolify's API as a job runner.
      </p>
    </section>

    <section class="border-t border-[var(--edge)] py-14">
      <h2 class="text-2xl font-semibold tracking-tight">Contributing</h2>
      <p class="mt-5 leading-relaxed text-[var(--ink-muted)]">
        The code lives in
        <a href={REPO} class="text-[var(--ink)] underline decoration-[var(--edge)] underline-offset-2 hover:decoration-[var(--accent)]">
          openpreflight/openpreflight
        </a>.
        <code class="font-mono text-sm">go test ./...</code> needs no network and no credentials —
        Coolify and GitHub are faked. Bug fixes with a failing test, small v1 gaps, and docs that
        match the code are welcome.
      </p>
      <ul class="mt-6 space-y-2 text-sm">
        <li>
          <a href={`${REPO}/blob/main/CONTRIBUTING.md`} class="font-mono text-[var(--accent)] hover:underline">
            CONTRIBUTING.md →
          </a>
        </li>
        <li>
          <a href={`${REPO}/issues/new/choose`} class="font-mono text-[var(--accent)] hover:underline">
            Issue templates →
          </a>
        </li>
        <li>
          <a href={`${DOCS}/contributing/development/`} class="font-mono text-[var(--accent)] hover:underline">
            Development guide →
          </a>
        </li>
      </ul>
    </section>
  </div>
</Layout>
