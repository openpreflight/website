---
import MarketingPage from '../../layouts/MarketingPage.astro';
import PageHero from '../../components/marketing/PageHero.astro';
import Section from '../../components/marketing/Section.astro';
import Grid from '../../components/marketing/Grid.astro';
import Card from '../../components/marketing/Card.astro';
import Actions from '../../components/marketing/Actions.astro';
import CtaLink from '../../components/marketing/CtaLink.astro';
import Callout from '../../components/marketing/Callout.astro';
import Prose from '../../components/marketing/Prose.astro';
import { CTA, DOCS, REPO } from '../../lib/site';

const shortVersion = [
  {
    want: 'A check on the commit, on a box you already run, with as little to operate as possible',
    pick: 'openpreflight',
    self: true,
  },
  {
    want: 'A real pipeline DSL: stages, matrices, caches, artifacts, fan-out',
    pick: 'Woodpecker or Drone',
    self: false,
  },
  {
    want: 'The same workflows you already have in .github/workflows/',
    pick: 'Self-hosted actions/runner',
    self: false,
  },
  {
    want: 'Anything that is not GitHub, or plugins for everything',
    pick: 'Jenkins',
    self: false,
  },
];

const neighbours = [
  {
    name: 'Woodpecker CI',
    summary:
      'The closest comparison, and for most people the better default: a container-native pipeline engine with a YAML DSL, matrix builds, plugins, multiple agents, and several forges.',
    them: 'Pick it if you want steps that are not install / test / build, matrix builds, artifacts between steps, more than one machine running jobs, or a forge that is not GitHub.',
    us: 'Pick this if the server-plus-agent split is more than you want to run for a handful of private repos.',
  },
  {
    name: 'Drone',
    summary:
      'The project Woodpecker forked from. Same shape: a server, runners, container-per-step pipelines, a mature plugin ecosystem, several forges.',
    them: 'Licensing changed after the acquisition. Check that against your own constraints.',
    us: 'The trade-off against this is the same as Woodpecker’s.',
  },
  {
    name: 'Self-hosted actions/runner',
    summary:
      'If your workflows are already GitHub Actions, this is usually the right answer. You keep the YAML, the marketplace, the matrix syntax, the caches, and the artifacts, and only change where the compute happens.',
    them: 'Pick it if you have workflows you want to keep, need the marketplace, or want GitHub to own the scheduling.',
    us: 'Pick this if you do not want Actions minutes involved at all, and would rather the whole CI surface be something you can read in an afternoon.',
  },
  {
    name: 'Jenkins',
    summary:
      'Two decades of plugins, every SCM, every language, every deployment shape. Nothing here competes with that, and nothing here tries.',
    them: 'Pick it if you need something a plugin already solves, or already run it.',
    us: 'Pick this if you would be installing Jenkins purely to get a green check on a private repo’s pull requests.',
  },
];

const rows = [
  {
    label: 'What it is',
    actions: 'An orchestration layer for workflows.',
    op: 'A Check Runs worker for one commit at a time.',
  },
  {
    label: 'Where jobs run',
    actions: 'Hosted runners, or a self-hosted <code>actions/runner</code>.',
    op: 'The server you installed the binary on.',
  },
  {
    label: 'Configuration',
    actions: 'Workflow YAML in <code>.github/workflows</code>.',
    op: '<code>.ci.yml</code>, binding overrides, or <code>package.json</code> scripts.',
  },
  {
    label: 'Reusable steps',
    actions: 'Marketplace actions.',
    op: 'Shell commands you write. There is no registry.',
  },
  {
    label: 'Matrices, caches, artifacts',
    actions: 'Yes.',
    op: 'Out of scope.',
  },
  {
    label: 'Where logs live',
    actions: 'On GitHub.',
    op: 'On your disk, behind <code>GET /runs/{id}</code>.',
  },
  {
    label: 'What you operate',
    actions: 'Nothing, or a runner fleet.',
    op: 'One binary, one SQLite file, one GitHub App.',
  },
];
---

<MarketingPage
  title="openpreflight and GitHub Actions"
  description="Actions orchestrates. openpreflight is a small self-hosted Check Runs worker. They can coexist; this does not replace workflow YAML."
>
  <PageHero
    kicker="Compare"
    title="Choose the right layer"
    lead="GitHub Actions is orchestration. openpreflight is a Check Runs worker you host. Use them together when that matches your setup. This is not a replacement for workflow YAML."
    crumbs={[
      { label: 'openpreflight', href: '/' },
      { label: 'Compare' },
      { label: 'GitHub Actions' },
    ]}
  >
    <Actions slot="actions">
      <CtaLink href="/product/" variant="primary" size="lg">What openpreflight does</CtaLink>
      <CtaLink href={`${DOCS}/getting-started/comparison/`} variant="outline" size="lg">
        Full docs comparison
      </CtaLink>
    </Actions>
  </PageHero>

  <Section
    badge="The short version"
    title="Pick by what you want"
    description="Actions is not the only neighbour. If one of the lower three rows describes you, the rest of this page is confirming a decision you have already made."
  >
    <div class="mt-12 overflow-hidden rounded-[1.5rem] border border-foreground/10">
      {
        shortVersion.map((row, i) => (
          <div
            class={`grid gap-2 p-5 sm:grid-cols-[1fr_16rem] sm:items-center sm:gap-6 sm:p-6 ${i > 0 ? 'border-t border-foreground/10' : ''} ${row.self ? 'bg-primary/[.04]' : ''}`}
          >
            <p class="text-sm leading-relaxed text-muted-foreground">{row.want}</p>
            <span
              class={`font-mono text-sm font-semibold ${row.self ? 'text-primary' : 'text-foreground'}`}
            >
              {row.pick}
            </span>
          </div>
        ))
      }
    </div>
  </Section>

  <Section badge="Side by side" title="Same repository, different job">
    <div class="mt-12 overflow-hidden rounded-[1.5rem] border border-foreground/10">
      <div class="hidden grid-cols-2 border-b border-foreground/10 bg-foreground/[0.03] sm:grid">
        <p class="px-5 py-4 font-mono text-xs font-semibold uppercase tracking-[0.06em] text-muted-foreground">
          GitHub Actions
        </p>
        <p class="px-5 py-4 font-mono text-xs font-semibold uppercase tracking-[0.06em] text-primary">
          openpreflight
        </p>
      </div>
      {
        rows.map((row, i) => (
          <div class={i > 0 ? 'border-t border-foreground/10' : ''}>
            <p class="px-5 pt-4 font-mono text-[0.68rem] uppercase tracking-[0.06em] text-muted-foreground/70">
              {row.label}
            </p>
            <div class="grid gap-x-5 gap-y-3 px-5 pb-5 pt-2 sm:grid-cols-2">
              <div>
                <p class="mb-1 font-mono text-[0.6rem] uppercase tracking-[0.06em] text-muted-foreground/60 sm:hidden">
                  GitHub Actions
                </p>
                <p
                  class="text-sm leading-relaxed text-muted-foreground [&_code]:font-mono [&_code]:text-[0.85em]"
                  set:html={row.actions}
                />
              </div>
              <div>
                <p class="mb-1 font-mono text-[0.6rem] uppercase tracking-[0.06em] text-primary/70 sm:hidden">
                  openpreflight
                </p>
                <p
                  class="text-sm leading-relaxed text-foreground [&_code]:font-mono [&_code]:text-[0.85em]"
                  set:html={row.op}
                />
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <Section badge="Together" title="They are not mutually exclusive" tone="dark">
    <Grid class="mt-12" cols={2}>
      <Card title="Keep Actions for what it is good at" tone="dark">
        Release pipelines, matrices across versions, artifact publishing,
        scheduled jobs, anything that needs the marketplace.
      </Card>
      <Card title="Add a worker you host" tone="dark">
        Install, test, and build on a private repo, reported as a Check Run,
        with the logs on hardware you already operate.
      </Card>
    </Grid>
    <p class="mt-10 max-w-2xl text-sm leading-relaxed text-background/60">
      Both can run on the same commit. GitHub shows every check that reports on
      it, whoever produced them.
    </p>
  </Section>

  <Section
    badge="Neighbours"
    title="The other three you are probably weighing"
    description="Most of these do more, and for a lot of teams doing more is the point. Worth reading before you commit to one of them."
  >
    <div class="mt-12 space-y-4">
      {
        neighbours.map((n) => (
          <article class="rounded-[1.5rem] border border-foreground/10 p-6 sm:p-7">
            <h3 class="font-mono text-base font-semibold tracking-tight">{n.name}</h3>
            <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted-foreground">{n.summary}</p>
            <div class="mt-5 grid gap-4 border-t border-foreground/10 pt-5 sm:grid-cols-2">
              <div>
                <p class="font-mono text-[0.62rem] uppercase tracking-[0.06em] text-muted-foreground/70">
                  Choose it
                </p>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{n.them}</p>
              </div>
              <div>
                <p class="font-mono text-[0.62rem] uppercase tracking-[0.06em] text-primary/70">
                  Choose openpreflight
                </p>
                <p class="mt-2 text-sm leading-relaxed text-foreground">{n.us}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
    <Prose class="mt-10">
      <p>
        The full write-up, including where this is weaker than every
        one of them, is in the{' '}
        <a href={`${DOCS}/getting-started/comparison/`}>docs comparison</a>. The short list
        of limits lives on <a href="/why/">why this shape</a>.
      </p>
    </Prose>
  </Section>

  <Section badge="Scope" title="Where that leaves this one">
    <Callout title="Summary">
      <p>
        If you need orchestration, use Actions or one of the neighbours above.
        If you need a private commit checked by a worker you own, this is the
        smaller answer. The exclusions that make it smaller, and the limits
        that come with them, are worked through on{' '}
        <a href="/why/">why this shape</a>, and the canonical list is{' '}
        <a href={`${REPO}#out-of-scope`}>Out of scope</a> in the code repository.
      </p>
    </Callout>
  </Section>

</MarketingPage>
